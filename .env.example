# Domain Status Configuration
# Copy this file to .env and customize as needed
#
# Configuration Precedence (highest to lowest):
# 1. Command-line arguments (scan flags, including -v/-q and --log-level)
# 2. Environment variables (this file, DOMAIN_STATUS_*, or exported in shell)
# 3. Config file (--config / DOMAIN_STATUS_CONFIG_FILE / domain_status.toml)
# 4. Default values
#
# Logging story (pick one primary approach):
# - Prefer -v / -vv / -q on the CLI for quick verbosity changes
# - Or set DOMAIN_STATUS_LOG_LEVEL=error|warn|info|debug|trace as the baseline
# - Optional RUST_LOG adds per-module filters (does not replace the baseline)

# MaxMind License Key (optional; required only for GeoIP lookup)
# Get a free key from: https://www.maxmind.com/en/accounts/current/license-key
# If not set, GeoIP lookup is disabled and the application continues normally
MAXMIND_LICENSE_KEY=your_license_key_here

# GitHub Token (optional, for fingerprint ruleset downloads)
# Increases GitHub API rate limit from 60 to 5000 requests/hour
# Only needed if using GitHub-hosted fingerprint rulesets
# GITHUB_TOKEN=your_github_token_here

# Baseline log level (same as --log-level; overridden by -v/-q)
# DOMAIN_STATUS_LOG_LEVEL=info

# Advanced per-module filters (optional; combined with the baseline above)
# Format: domain_status=debug,reqwest=info
# RUST_LOG=domain_status=debug

# Optional path to TOML config (alternative to --config)
# DOMAIN_STATUS_CONFIG_FILE=./domain_status.toml
